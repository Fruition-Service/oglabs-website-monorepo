{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "oglabs-website",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "oglabs.io/*", "zone_name": "oglabs.io" },
    { "pattern": "www.oglabs.io/*", "zone_name": "oglabs.io" }
  ],
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "PLACEHOLDER_KV_ID"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "oglabs-website"
    }
  ]
}
